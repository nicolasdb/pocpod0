# Copy to .env, fill in, then: chmod 600 .env   (and keep .env out of git)

# Your Community Solid Server instance = the OIDC issuer for both tokens.
SOLID_OIDC_ISSUER=https://pod.nicolasdb.eu/

# ---------------------------------------------------------------------------
# AGENT credentials — held by the running agent.
# Created at https://pod.nicolasdb.eu/.account/ -> client credentials,
# associated with the AGENT's WebID (nicolas_claude).
# ---------------------------------------------------------------------------
SOLID_CLIENT_ID=
SOLID_CLIENT_SECRET=
AGENT_WEBID=https://pod.nicolasdb.eu/nicolas_claude/profile/card#me

# ---------------------------------------------------------------------------
# OWNER credentials — used ONLY by src/onboarding.js, run by you, once, to
# grant the agent its access. Do NOT deploy these alongside the agent; fill
# them in, run onboarding, then remove them from this file again.
# Associated with the OWNER's WebID (hyperscope_ndb).
# ---------------------------------------------------------------------------
OWNER_CLIENT_ID=
OWNER_CLIENT_SECRET=
OWNER_WEBID=https://pod.nicolasdb.eu/hyperscope_ndb/profile/card#me
