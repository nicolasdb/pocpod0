# VPS-specific overrides — applied on top of .env after vps-push
# These values differ from local dev defaults and must survive every rsync.
# Add any var here that should be pinned on the VPS.
OPENCLAW_GATEWAY_HOST=0.0.0.0
OPENCLAW_GATEWAY_BIND=lan

# CSS public identity — pods must carry the public WebID URI, not localhost,
# so teammates get correct/stable WebIDs for cross-pod ACL testing.
CSS_BASE_URL=https://pod.nicolasdb.eu
CSS_IDENTIFIER_URL=https://pod.nicolasdb.eu
CSS_IDENTIFIER_HOST=pod.nicolasdb.eu
