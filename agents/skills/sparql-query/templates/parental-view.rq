# parental-view.rq
# Query learning activities for two children (unified parental view).
# Parameters: $child_pod_1 (pod root URI), $child_pod_2 (pod root URI)
#
# Both pod URIs must end with "/" (trailing slash enforced by handler).
# ACL enforcement upstream: parent WebID must have read access to both pods.
# Scopes to both pod namespaces via FILTER(strstarts(str(?g), str(?childPod))).
#
# Uses pocpod0: vocabulary (matches oslo_mapper.py output).
# Returns actor URI so caller can distinguish child-1 vs child-2 by pod prefix.
PREFIX pocpod0: <https://poc-pod0.edu/vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?g ?actor ?verb ?object ?scaledScore ?success ?timestamp WHERE {
  VALUES ?childPod { $child_pod_1 $child_pod_2 }
  GRAPH ?g {
    ?activity rdf:type pocpod0:LearningStatement .
    ?activity pocpod0:actor ?actor .
    ?activity pocpod0:verb ?verb .
    ?activity pocpod0:object ?object .
    OPTIONAL {
      ?activity pocpod0:result ?result .
      OPTIONAL { ?result pocpod0:scaledScore ?scaledScore . }
      OPTIONAL { ?result pocpod0:success ?success . }
    }
    OPTIONAL { ?activity pocpod0:timestamp ?timestamp . }
  }
  FILTER(strstarts(str(?g), str(?childPod)))
}
ORDER BY ?childPod ?timestamp
LIMIT 500
