# OpenRouter API key (the only external secret)
OPENROUTER_API_KEY=your-key-here

# Volume mount flags for bind mounts: set to ",Z" on Fedora/SELinux, leave empty on Ubuntu/VPS
VOLUME_FLAGS=

# CSS base URL — direct CSS port (Story 6.2: use :3000 not :8080/nginx)
CSS_BASE_URL=http://localhost:3000
CSS_IDENTIFIER_URL=http://localhost:3000

# SPARQL skill service-account WebID for writing access receipts (Story 5.4 BP-1)
SPARQL_SKILL_WEBID=http://localhost:3000/sparql-skill/profile/card#me

# CSS three-var model for Docker-internal routing (Story 3.1)
# CSS_CONNECT_URL: TCP endpoint inside Docker network
# CSS_IDENTIFIER_HOST: Host header so CSS recognizes its identifier space
CSS_CONNECT_URL=http://community-solid-server:3000
CSS_IDENTIFIER_HOST=localhost:3000

# Service URLs for skills (Docker-internal)
OXIGRAPH_URL=http://oxigraph:7878
QDRANT_URL=http://qdrant:6333

# Service ports
CSS_PORT=3000
OXIGRAPH_PORT=7878
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# OpenClaw gateway (GHCR official image)
# use token & password on gateway webpage then `openclaw devices approve` in CLI
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_PORT=18790
OPENCLAW_GATEWAY_BIND=lan        # local: lan or all; VPS: all (nginx needs to reach it)
OPENCLAW_GATEWAY_HOST=127.0.0.1  # local: 127.0.0.1; VPS: 0.0.0.0 (nginx on gateway network)
OPENCLAW_GATEWAY_TOKEN=generate-with-openssl-rand-hex-32
GOG_KEYRING_PASSWORD=generate-with-openssl-rand-hex-32

# Discord bot (Story 4.0)
# Follow the Discord Setup Checklist in 4-0-discord-seed-on-boot-infrastructure.md (lines 191-280)
DISCORD_BOT_TOKEN=                    # Step 2: Bot tab → Reset Token
DISCORD_GUILD_ID=                     # Step 5: Right-click server name → Copy Server ID
DISCORD_CHANNEL_CLAIRE=               # Step 4: #claire-teacher channel ID
DISCORD_CHANNEL_MARC=                 # Step 4: #marc-admin channel ID
DISCORD_CHANNEL_ISABELLE=             # Step 4: #isabelle-policy channel ID
DISCORD_CHANNEL_FATIMA=               # Step 4: #fatima-parent channel ID
DISCORD_CHANNEL_AYOUB=                # Step 4: #ayoub-student channel ID
DISCORD_CHANNEL_TROLL=                # Step 4: #troll-adversary channel ID
DISCORD_CHANNEL_GENERAL=              # Step 4: #general channel ID
DISCORD_CHANNEL_SECURITY_LOGS=        # Step 4: #security-logs channel ID
DISCORD_ALLOW_FROM=                   # Step 6: discord:<your_user_id> — DM allowlist
